{{ attach_library('quanthub_datasetexplorer/dataset-explorer') }}

<div class="datasetexplorer">
  <div id="dataset_explorer">
    {% if installed %}
      <div class="spinner spinner--explorer">
        <div class="spinner__bg">
          <div class="spinner__circle"></div>
        </div>
      </div>
    {% else %}
      <p class="error">
        <strong>
          {{ 'Failed to load the Dataset Explorer library.'|t }}
        </strong>
      </p>
    {% endif %}
  </div>
</div>
